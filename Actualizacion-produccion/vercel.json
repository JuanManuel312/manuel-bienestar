{
  "$schema":"https://openapi.vercel.sh/vercel.json",
  "framework":null,
  "buildCommand":"npm run build",
  "outputDirectory":"public",
  "functions":{"api/shop.js":{"maxDuration":60}},
  "rewrites":[{"source":"/pago","destination":"/index.html"},{"source":"/mi-guia","destination":"/index.html"}],
  "headers":[{"source":"/(.*)","headers":[{"key":"X-Content-Type-Options","value":"nosniff"},{"key":"Referrer-Policy","value":"no-referrer"},{"key":"X-Frame-Options","value":"DENY"}]},{"source":"/index.html","headers":[{"key":"Cache-Control","value":"no-cache"}]},{"source":"/app.js","headers":[{"key":"Cache-Control","value":"no-cache"}]}]
}
